@model Movimiento
@{
    ViewData["Title"] = "Editar movimiento";
}

<div class="max-w-xl mx-auto py-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden p-8">
        <!-- Encabezado del Formulario -->
        <div class="mb-6 border-b border-slate-100 pb-4">
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Editar movimiento</h1>
            <p class="text-sm text-slate-500 mt-1">Actualiza los datos del movimiento seleccionado.</p>
        </div>

        <form asp-action="Edit" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />

            <!-- Tipo de Movimiento -->
            <div>
                <label asp-for="Tipo" class="block text-sm font-semibold text-slate-700 mb-2"></label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMovimiento>()" class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"></select>
            </div>

            <!-- Monto -->
            <div>
                <label asp-for="Monto" class="block text-sm font-semibold text-slate-700 mb-2"></label>
                <input asp-for="Monto" class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all placeholder-slate-400" />
                <span asp-validation-for="Monto" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Descripción -->
            <div>
                <label asp-for="Descripción" class="block text-sm font-semibold text-slate-700 mb-2"></label>
                <input asp-for="Descripción" class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all placeholder-slate-400" />
                <span asp-validation-for="Descripción" class="text-xs text-rose-600 mt-1 block"></span>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center justify-end space-x-4 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium transition-colors">Cancelar</a>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-xl transition-all shadow-sm hover:shadow">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}