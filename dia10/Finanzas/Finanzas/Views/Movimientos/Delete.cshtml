@model Movimiento
@{
    ViewData["Title"] = "Eliminar movimiento";
}

<div class="max-w-xl mx-auto py-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden p-8">
        <!-- Encabezado de Advertencia -->
        <div class="mb-6 border-b border-slate-100 pb-4">
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Eliminar movimiento</h1>
            <p class="text-sm text-rose-600 font-medium mt-1">¿Estás seguro de que quieres eliminar este movimiento? Esta acción no se puede deshacer.</p>
        </div>

        <!-- Detalles del Movimiento a Eliminar -->
        <div class="bg-slate-50 rounded-2xl p-6 space-y-4 mb-6 border border-slate-100">
            <div class="flex flex-col sm:flex-row justify-between sm:items-center">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Tipo</span>
                <span class="text-sm font-semibold text-slate-800 mt-1 sm:mt-0">@Model.Tipo</span>
            </div>
            <div class="border-t border-slate-200/60 pt-3 flex flex-col sm:flex-row justify-between sm:items-center">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Descripción</span>
                <span class="text-sm font-medium text-slate-800 mt-1 sm:mt-0">@Model.Descripción</span>
            </div>
            <div class="border-t border-slate-200/60 pt-3 flex flex-col sm:flex-row justify-between sm:items-center">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Monto</span>
                <span class="text-sm font-bold text-slate-900 mt-1 sm:mt-0">@Model.Monto.ToString("N0") Gs</span>
            </div>
        </div>

        <!-- Formulario de Confirmación -->
        <form asp-action="DeleteConfirmed" method="post" class="flex items-center justify-end space-x-4 pt-4 border-t border-slate-100">
            <input type="hidden" name="id" value="@Model.Id" />
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium transition-colors">Cancelar</a>
            <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white font-medium px-6 py-2.5 rounded-xl transition-all shadow-sm hover:shadow">Sí, eliminar</button>
        </form>
    </div>
</div>