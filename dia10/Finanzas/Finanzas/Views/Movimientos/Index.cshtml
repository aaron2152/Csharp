@model List<Movimiento>
@{
    ViewData["Title"] = "Movimientos";
    int ingresos = Model.Where(m => m.Tipo == TipoMovimiento.Ingreso).Sum(m => m.Monto);
    int egresos = Model.Where(m => m.Tipo == TipoMovimiento.Egreso).Sum(m => m.Monto);
    int saldo = ingresos - egresos;
}

<div class="max-w-6xl mx-auto space-y-8">
    <!-- Encabezado y Botón de Nuevo Movimiento -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Movimientos Financieros</h1>
            <p class="text-sm text-slate-500 mt-1">Administra tus ingresos y egresos de forma sencilla.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2.5 rounded-xl transition-all shadow-sm hover:shadow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nuevo movimiento
        </a>
    </div>

    <!-- Tarjetas de Resumen (Ingresos, Egresos, Saldo) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Ingresos -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-slate-500">Total Ingresos</p>
                <h3 class="text-2xl font-bold text-emerald-600 mt-1">@ingresos.ToString("N0") Gs</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl">
                ↓
            </div>
        </div>

        <!-- Egresos -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-slate-500">Total Egresos</p>
                <h3 class="text-2xl font-bold text-rose-600 mt-1">@egresos.ToString("N0") Gs</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-xl">
                ↑
            </div>
        </div>

        <!-- Saldo Total -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
            <div>
                <p class="text-sm font-medium text-slate-500">Saldo Actual</p>
                <h3 class="text-2xl font-bold @(saldo >= 0 ? "text-indigo-600" : "text-rose-600") mt-1">
                    @saldo.ToString("N0") Gs
                </h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl">
                $
            </div>
        </div>
    </div>

    <!-- Tabla de Movimientos -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/70 border-b border-slate-100 text-xs font-semibold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-6">Id</th>
                        <th class="py-4 px-6">Tipo</th>
                        <th class="py-4 px-6">Descripción</th>
                        <th class="py-4 px-6">Monto</th>
                        <th class="py-4 px-6 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                    @foreach (Movimiento m in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="py-4 px-6 font-medium text-slate-900">@m.Id</td>
                            <td class="py-4 px-6">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold @(m.Tipo.ToString() == "Ingreso" ? "bg-emerald-50 text-emerald-600" : "bg-rose-50 text-rose-600")">
                                    @m.Tipo
                                </span>
                            </td>
                            <td class="py-4 px-6">@m.Descripción</td>
                            <td class="py-4 px-6 font-semibold @(m.Tipo.ToString() == "Ingreso" ? "text-emerald-600" : "text-rose-600")">
                                @m.Monto.ToString("N0") Gs
                            </td>
                            <td class="py-4 px-6 text-right space-x-3">
                                <a asp-action="Edit" asp-route-id="@m.Id" class="text-indigo-600 hover:text-indigo-800 font-medium transition-colors">Editar</a>
                                <span class="text-slate-300">|</span>
                                <a asp-action="Delete" asp-route-id="@m.Id" class="text-rose-600 hover:text-rose-800 font-medium transition-colors">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>