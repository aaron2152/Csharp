@model List<Cliente>
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<!-- Header de la sección -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>@ViewData["Title"]
        </h1>
        <p class="text-muted small mb-0">Administra y organiza el directorio de tus clientes registrados.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span>Nuevo Cliente</span>
        </a>
    </div>
</div>

<!-- Alertas y Mensajes de Error/Éxito -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Barra de Filtros y Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, teléfono o ciudad...">
                </div>
            </div>
            <div class="col-md-6 col-lg-8 text-md-end text-muted small">
                <span>Total de clientes: <strong class="badge bg-secondary rounded-pill px-2 py-1 fs-6">@Model.Count</strong></span>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Clientes -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="clientesTable">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="ps-4">ID</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Teléfono</th>
                    <th scope="col">Ciudad</th>
                    <th scope="col" class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (Cliente c in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-bold">#@c.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(c.Nombre) ? "?" : c.Nombre.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@c.Nombre</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="tel:@c.Telefono" class="text-decoration-none text-body">
                                    <i class="bi bi-telephone text-muted me-1"></i>@c.Telefono
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    <i class="bi bi-geo-alt me-1 text-danger"></i>@c.Ciudad
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de cliente">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-info" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-4 d-block mb-3 opacity-50"></i>
                            <p class="mb-1 fw-bold">No hay clientes registrados</p>
                            <small class="d-block mb-3">Comienza agregando tu primer cliente en la plataforma.</small>
                            <a asp-action="Create" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>Registrar Cliente
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Filtro rápido de búsqueda instantánea en JS
        document.getElementById('searchInput')?.addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#clientesTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(filter)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}